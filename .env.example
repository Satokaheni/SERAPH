# SERAPH Environment Configuration
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# ── Required ─────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-your-key-here

# ── Optional: logging ────────────────────────────────────────
# DEBUG, INFO, WARNING, ERROR
SERAPH_LOG_LEVEL=INFO

# ── Optional: baseline modes ─────────────────────────────────
# 'feature_based' (default, no GPU needed)
# 'checkpoint'    (requires pretrained model files — GPU recommended)
DIALOGUE_RNN_MODE=feature_based
CEM_MODE=llm_approximation
MIME_MODE=llm_approximation

# ── Optional: Lambda Labs / GPU instance ─────────────────────
# Set these if running on a GPU instance with checkpoint models
# DIALOGUE_RNN_MODE=checkpoint
# CEM_MODE=checkpoint
# MIME_MODE=checkpoint
